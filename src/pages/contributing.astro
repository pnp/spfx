---
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { catalog } from '../lib/catalog';
import ContributorRecognition from '../components/ContributorRecognition.astro';
import { COMMUNITY } from '../lib/community';
const descriptions: Record<string, { title: string; description: string }> = {
  'pnp/sp-dev-fx-webparts': { title: 'Web parts', description: 'Useful building blocks for SharePoint pages, portals and supported Microsoft 365 hosts.' },
  'pnp/sp-dev-fx-extensions': { title: 'Extensions', description: 'Custom forms, commands, fields and application-level experiences.' },
  'pnp/spfx-copilot-components': { title: 'Copilot components', description: 'Interactive experiences that bring ideas into the Copilot canvas.' },
  'pnp/spfx-reference-scenarios': { title: 'Reference scenarios', description: 'Connected solutions that put several patterns together.' },
  'pnp/sp-dev-fx-aces': { title: 'Adaptive Card Extensions', description: 'Small, useful experiences for Connections and the flow of work.' },
};
---
<BaseLayout title="Contributing" description="Share your Microsoft 365 building blocks with the community. Find the right source repository for your sample." showRecognition={false}>
  <header class="page-heading container"><p class="eyebrow">There's room for your idea</p><h1>Build it. Share it.<br />Help someone make it better.</h1><p class="page-lead">A sample doesn't have to solve everything. Sometimes one thoughtful pattern is exactly the head start someone else needs.</p></header>
  <section class="container page-content">
    <div class="wide-guide">
      <ContributorRecognition />
      <section class="content-panel"><h2>Good contributions come in every size</h2><p>Share a new sample, clarify setup instructions, improve accessibility, report a reproducible problem, or help someone understand a pattern. This is a community, not a competition.</p><p><strong>Sample changes go to the source repository.</strong> This central gallery collects metadata, not sample projects. Follow that repository's contribution guidance, README template, validation and licensing requirements.</p></section>
      <div class="source-list" id="choose-a-source">
        {catalog.sources.map((source) => <section class="source-item"><div><h2>{descriptions[source.repository]?.title ?? source.repository}</h2><p>{descriptions[source.repository]?.description ?? 'Contribute in the original sample repository.'}</p><p>{source.samples.toLocaleString('en')} sample record{source.samples === 1 ? '' : 's'} · {source.repository}</p></div><a class="guide-link" href={`https://github.com/${source.repository}`}>Open repository <ArrowUpRight size={14} aria-hidden="true" /></a></section>)}
      </div>
      <section class="content-panel"><h2>Help your sample shine</h2><ul><li>Write a clear title and explain the problem your sample solves.</li><li>Declare the SPFx version that the actual packages use, including prerelease suffixes where relevant.</li><li>Add a genuine screenshot with useful alternative text. Never substitute a generic placeholder for evidence of the experience.</li><li>Credit every contributor and link to the sample's final source location.</li><li>Keep prerequisites, permissions and setup steps accurate and complete.</li></ul><p>For gallery navigation, filtering or presentation issues, use the central repository. For code or setup questions, use the sample's source repository.</p><a class="guide-link" href="https://github.com/pnp/spfx/issues/new">Help improve this gallery <ArrowUpRight size={14} aria-hidden="true" /></a></section>
      <section class="content-panel" id="community-calls"><h2>Keep up with the community</h2><p>Join the Copilot, Microsoft 365 and Power Platform community calls. Learn from real scenarios, hear what's changing and connect with people building alongside you. Everyone is welcome.</p><a class="guide-link" href={COMMUNITY.calls}>Join the community calls <ArrowUpRight size={14} aria-hidden="true" /></a></section>
      <section class="content-panel" id="present-a-demo"><h2>Have something to show?</h2><p>A useful pattern, a customer scenario, a solution or something you've been experimenting with can help someone else. You do not need a finished product or a polished presentation to start the conversation.</p><p><a href={COMMUNITY.demo}>Fill in the community demo request form</a>. Tell us what you'd like to share and your availability; we'll work with you to find a suitable community call slot.</p><a class="guide-link" href={COMMUNITY.demo}>Sign up to present a demo <ArrowUpRight size={14} aria-hidden="true" /></a></section>
      <section class="content-panel"><h2>New to contributing?</h2><p>The Sharing is Caring program helps new contributors build confidence with GitHub and community contributions. Start small, ask questions and share what you learn.</p><a class="guide-link" href={COMMUNITY.learning}>Explore Sharing is Caring <ArrowUpRight size={14} aria-hidden="true" /></a></section>
    </div>
  </section>
</BaseLayout>
