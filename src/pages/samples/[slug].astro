---
import { ArrowLeft, ArrowRight, ArrowUpRight, Bookmark, Check, Download, GitFork } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { catalog, formatDate, formatVersion, samplePath, sitePath } from '../../lib/catalog';
import type { Sample } from '../../lib/types';
export function getStaticPaths() {
  return catalog.samples.map((sample) => ({ params: { slug: sample.slug }, props: { sample } }));
}
interface Props { sample: Sample }
const { sample } = Astro.props;
const imagePath = (src: string) => src.startsWith('/') ? sitePath(src) : src;
const morePreviews = sample.previews.filter((preview) => !preview.isFallback && preview.src !== sample.preview.src).slice(0, 8);
const related = catalog.samples.filter((candidate) => candidate.id !== sample.id
  && candidate.experiences.some((experience) => sample.experiences.includes(experience))).slice(0, 4);
---
<BaseLayout title={sample.title} description={sample.description} image={imagePath(sample.preview.src)}>
  <header class="detail-heading page-heading container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={sitePath('/')}>Samples</a><span aria-hidden="true">/</span><span>{sample.family}</span></nav>
    <p class="eyebrow">{sample.experiences.join(' / ') || 'Microsoft 365'} · Community sample</p>
    <h1>{sample.title}</h1>
    <p class="page-lead">{sample.description}</p>
    <div class="detail-badges">
      {sample.componentTypes.map((type) => <span>{type}</span>)}
      {sample.technologies.map((technology) => <span>{technology}</span>)}
      <span>{formatVersion(sample)}</span>
    </div>
  </header>
  <section class="container page-content detail-layout" aria-label="Sample details">
    <div class="detail-main">
      <div class:list={['detail-preview', { 'is-fallback': sample.preview.isFallback }]} data-preview-wrap>
        <img data-preview-image src={imagePath(sample.preview.src)} alt={sample.preview.alt} width="960" height="540" decoding="async" referrerpolicy="no-referrer" />
        <span class="fallback-label" data-fallback-label hidden={!sample.preview.isFallback}>Preview unavailable</span>
      </div>
      {sample.quality.needsReview && <div class="quality-notice"><strong>A little context before you build</strong>This source metadata has known inconsistencies. Version badges reflect declared metadata, not a guarantee of compatibility. Check the source README and package dependencies before getting started.</div>}
      <section class="content-panel">
        <h2>The idea behind the sample</h2>
        {sample.descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <h3>Make it your own</h3>
        <p>Start with the author's setup instructions, explore the implementation, and adapt the pattern to your environment. Sample code stays in its original repository, together with its requirements, license and contribution history.</p>
        <a class="guide-link" href={sample.sourceUrl}>Read the source documentation <ArrowUpRight size={14} aria-hidden="true" /></a>
      </section>
      {morePreviews.length > 0 && <section class="content-panel"><h2>A closer look</h2><div class="detail-gallery">
        {morePreviews.map((preview) => <figure><div class="detail-preview" data-preview-wrap><img data-preview-image src={imagePath(preview.src)} alt={preview.alt} width="640" height="360" loading="lazy" decoding="async" referrerpolicy="no-referrer" /><span class="fallback-label" data-fallback-label hidden>Preview unavailable</span></div><figcaption>{preview.alt}</figcaption></figure>)}
      </div></section>}
      {sample.references.length > 0 && <section class="content-panel"><h2>Keep exploring</h2><ul>{sample.references.map((reference) => <li><a href={reference.url}>{reference.title} <ArrowUpRight size={12} aria-hidden="true" /></a>{reference.description && <span> — {reference.description}</span>}</li>)}</ul></section>}
      {sample.issues.length > 0 && <section class="quality-notice" aria-label="Source metadata notes"><strong>Transparent by design</strong>The gallery preserves source attribution and known metadata issues instead of silently rewriting them.<details><summary>View {sample.issues.length} source metadata note{sample.issues.length === 1 ? '' : 's'}</summary><ul>{sample.issues.map((issue) => <li><strong>{issue.field}</strong>: {issue.message}</li>)}</ul><a href={sample.metadataUrl}>View the collected metadata <ArrowUpRight size={12} aria-hidden="true" /></a></details></section>}
      {related.length > 0 && <section class="content-panel"><h2>Keep the ideas flowing</h2><ul>{related.map((candidate) => <li><a href={samplePath(candidate.slug)}>{candidate.title} <ArrowRight size={12} aria-hidden="true" /></a></li>)}</ul></section>}
      <a class="text-link" href={sitePath('/#explore')}><ArrowLeft size={15} aria-hidden="true" /> Back to all possibilities</a>
    </div>
    <aside class="detail-side" aria-label="Sample resources">
      <div class="detail-actions">
        <a class="button" href={sample.sourceUrl}><GitFork size={16} aria-hidden="true" /> View on GitHub <ArrowUpRight size={13} aria-hidden="true" /></a>
        <a class="secondary-control" href={sample.downloadUrl}><Download size={15} aria-hidden="true" /> Download sample</a>
        <button class="save-button detail-save" type="button" data-save-id={sample.id} data-save-title={sample.title} aria-pressed="false" aria-label={`Save ${sample.title}`} disabled><Bookmark size={16} class="save-outline" aria-hidden="true" /><Check size={16} class="save-check" aria-hidden="true" /><span data-save-label>Save to collection</span></button>
      </div>
      <section class="content-panel"><h2>At a glance</h2><dl class="detail-facts">
        <div><dt>Experience</dt><dd>{sample.experiences.join(', ') || 'Microsoft 365'}</dd></div>
        <div><dt>Framework</dt><dd>{sample.framework === 'SharePoint Framework' ? 'SPFx' : sample.framework}{sample.framework !== 'SharePoint Framework' && sample.frameworkVersion ? ` · ${sample.frameworkVersion}` : ''}</dd></div>
        <div><dt>Declared SPFx version</dt><dd>{sample.framework === 'Bot Framework' ? 'Not applicable' : sample.version ?? 'Not recorded'}</dd></div>
        <div><dt>First published</dt><dd>{formatDate(sample.created)}</dd></div>
        <div><dt>Metadata last updated</dt><dd>{formatDate(sample.updated)}</dd></div>
        <div><dt>Source repository</dt><dd><a href={`https://github.com/${sample.repository}`}>{sample.repository}</a></dd></div>
        <div><dt>Collected revision</dt><dd><a href={sample.revisionUrl}>View pinned source <ArrowUpRight size={12} aria-hidden="true" /></a></dd></div>
      </dl></section>
      <section class="content-panel"><h2>Made by the community</h2><div class="detail-people">
        {sample.authors.map((author) => <div class="detail-person">{author.avatar ? <img src={author.avatar} width="32" height="32" alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span class="avatar-initial" aria-hidden="true">{author.name.slice(0, 1)}</span>}{author.account ? <a href={`${sitePath('/')}?author=${encodeURIComponent(author.account)}#explore`}>{author.name}</a> : <span>{author.name}</span>}</div>)}
      </div></section>
      <a class="sidebar-link" href={`https://github.com/${sample.repository}/issues/new?title=${encodeURIComponent(`Sample: ${sample.title}`)}`}>Ask a question in the source repo <ArrowUpRight size={12} aria-hidden="true" /></a>
    </aside>
  </section>
</BaseLayout>
