{
  "name": "spfx-sample-gallery",
  "private": true,
  "packageManager": "npm@11.21.1",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "samples:collect": "node .github/scripts/collect-samples.mjs",
    "samples:audit": "node .github/scripts/audit-samples.mjs",
    "samples:baseline": "node .github/scripts/audit-samples.mjs --update-baseline",
    "samples:refresh": "npm run samples:collect && npm run samples:audit",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "predev": "npm run catalog:generate",
    "dev": "astro dev --host 127.0.0.1",
    "check": "npm run catalog:generate && astro check",
    "build": "npm run samples:audit && npm run catalog:generate && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "pretest": "npm run catalog:generate",
    "test": "node --test .github/scripts/sample-metadata.test.mjs tests/catalog.test.mjs tests/discovery.test.mjs tests/previews.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.65.0",
    "astro": "^7.4.4",
    "jsonc-parser": "^3.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
